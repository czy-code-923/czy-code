  "components": {
    "securitySchemes": {
      "HostID": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Host-ID"
      },
      "AdminToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "AgentToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "ScopedAPIKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "xs_ API key",
        "description": "Choose permissions in Settings > API. Never pass the root token to a bot."
      }
    },
    "schemas": {
      "HostInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "NodeInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "engine"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "sing-box",
              "frp"
            ]
          }
        }
      },
      "InstanceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "host_id",
          "node_id",
          "listen_port"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "host_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "listen_port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        }
      },
      "TunnelInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "instance_id",
          "local_port",
          "remote_port"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "instance_id": {
            "type": "string"
          },
          "local_host": {
            "type": "string",
            "enum": [
              "127.0.0.1",
              "::1"
            ],
            "default": "127.0.0.1"
          },
          "local_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "remote_port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        }
      },
      "RouteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hops"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hops": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true
          }
        }
      },
      "ConfigInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outbound"
        ],
        "properties": {
          "outbound": {
            "type": "string",
            "enum": [
              "direct",
              "block"
            ]
          }
        }
      },
      "DeployInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config_id"
        ],
        "properties": {
          "config_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "staging"
            ],
            "default": "simulation"
          }
        }
      },
      "CompleteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lease_token",
          "success"
        ],
        "properties": {
          "lease_token": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "artifact_checksum": {
            "type": "string",
            "description": "Required 64 lowercase hex for successful staging; empty for simulation."
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "HostCreated": {
        "type": "object",
        "required": [
          "id",
          "agent_token"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_token": {
            "type": "string",
            "description": "Returned once. Store privately."
          }
        }
      },
      "ConfigCreated": {
        "type": "object",
        "required": [
          "id",
          "version",
          "spec",
          "checksum"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "spec": {
            "$ref": "#/components/schemas/Manifest"
          },
          "checksum": {
            "type": "string"
          }
