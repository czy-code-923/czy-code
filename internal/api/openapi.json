          "managed_users": {
            "type": "boolean",
            "description": "Independent protocol identities and personal traffic accounting. SS requires sing-box 2022 AES; Snell requires sing-box 1.14+ clients with userkey. Both need Agent 0.23+. Existing shared-key mode stays shared and cannot infer personal usage."
          },
          "snell_version": {
            "type": "integer",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "up_mbps": {
            "type": "integer",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "down_mbps": {
            "type": "integer",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "cipher": {
            "type": "string",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "snell_obfs": {
            "type": "string",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "snell_host": {
            "type": "string",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "snell_mode": {
            "type": "string",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "hy2_obfs_password": {
            "type": "string",
            "description": "Protocol-specific option; requires Agent 0.9+"
          },
          "clear_hy2_obfs": {
            "type": "boolean",
            "description": "Explicitly disable stored Hysteria2 obfuscation"
          },
          "username": {
            "type": "string",
            "maxLength": 128,
            "description": "HTTP/SOCKS/Mixed/Naive template login; managed users use the stable user ID."
          },
          "hysteria_obfs_password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 256
          },
          "clear_hysteria_obfs": {
            "type": "boolean"
          },
          "listen_network": {
            "type": "string",
            "enum": [
              "tcp,udp",
              "tcp",
              "udp"
            ],
            "description": "Shadowsocks native OS listener networks, separate from transport framing. Absent defaults to TCP+UDP. Requires Agent 0.19."
          }
        }
      },
      "TelegramSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "enabled",
          "chat_id",
          "quota_percent"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "bot_token": {
            "type": "string",
            "writeOnly": true,
            "description": "Empty preserves existing encrypted token; never returned."
          },
          "token_configured": {
            "type": "boolean"
          },
          "chat_id": {
            "type": "string",
            "pattern": "^-?[1-9][0-9]{0,18}$"
          },
          "command_polling": {
            "type": "boolean"
          },
          "allowed_user_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "commands": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "enum": [
                "status",
                "hosts",
                "traffic",
                "users",
                "devices",
                "help"
              ]
            }
          },
          "events": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "enum": [
                "host_offline",
                "host_online",
                "quota",
                "certificate",
                "host_quota",
                "device_limit"
              ]
            }
          },
          "report_minutes": {
            "type": "integer",
            "description": "0 disabled; otherwise 15-10080 minutes"
          },
          "report_sections": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "enum": [
                "status",
                "hosts",
                "traffic",
                "users",
                "devices"
              ]
            }
          },
          "quota_percent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "ClientPolicyDefinition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "basic": {
            "type": "object",
            "description": "Client base options in Mihomo vocabulary; local management listens on loopback"
          },
          "dns": {
            "type": "object",
            "description": "DNS configuration independent of base options and routing"
          },
          "proxy-groups": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object"
            }
          },
          "rules": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HostTrafficSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quota_bytes",
          "mode",
          "reset_day",
          "auto_reset",
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "quota_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9000000000000000
          },
          "mode": {
            "type": "string",
            "enum": [
              "both",
              "rx",
              "tx",
              "max"
            ],
            "description": "RX/TX are from the host interface perspective. max uses cumulative period totals."
          },
          "reset_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "auto_reset": {
            "type": "boolean"
          },
          "interfaces": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string"
            },
            "description": "Empty selects OS-detected uplink interfaces; selecting an interface never retroactively adds its old counters."
          }
        }
      },
      "HostTrafficCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quota_bytes",
          "mode",
          "reset_day",
          "auto_reset"
        ],
        "properties": {
          "quota_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9000000000000000
          },
          "mode": {
            "type": "string",
            "enum": [
              "both",
              "rx",
              "tx",
              "max"
            ],
            "description": "RX/TX are from the host interface perspective. max uses cumulative period totals."
          },
          "reset_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "auto_reset": {
            "type": "boolean"
          },
          "interfaces": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string"
            },
            "description": "Empty selects OS-detected uplink interfaces; selecting an interface never retroactively adds its old counters."
          },
          "initial_used_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9000000000000000,
            "description": "Provider usage before this Agent starts tracking; do not infer from OS lifetime counters."
          }
        }
      },
      "ReverseProxyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "upstream",
          "certificate_id"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "upstream": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTP/HTTPS origin or explicit HTTP loopback app port. DNS is checked and pinned by the local root gateway. Private/link-local/reserved management targets denied."
          },
          "certificate_id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "version": {
            "type": "integer"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "connect_timeout": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "default": 10
              },
              "read_timeout": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "default": 300
              },
              "body_limit_mib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "default": 16
              },
              "websocket": {
                "type": "boolean",
                "default": true
              },
              "host_header": {
                "type": "string",
                "description": "Optional DNS Host header; no raw Nginx directives"
              }
            }
          }
        }
      },
      "ManagedCertificateInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "provider"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "http-01",
              "cloudflare",
              "manual"
            ]
          },
          "email": {
            "type": "string"
          },
          "dns_token": {
            "type": "string",
            "writeOnly": true
          },
          "certificate": {
            "type": "string",
            "writeOnly": true
          },
          "private_key": {
            "type": "string",
            "writeOnly": true
          },
          "version": {
            "type": "integer",
            "description": "Use current version on edit; legacy manual import accepts zero"
          }
        }
      }
    }
  }
}

