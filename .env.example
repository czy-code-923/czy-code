# Documentation only; generate .env with scripts/init_env.py.
POSTGRES_PASSWORD=generate-a-random-password
ADMIN_TOKEN=generate-at-least-32-random-bytes
ENGINE_SECRET=generate-and-preserve-a-separate-random-engine-secret
# Filled by scripts/demo.py for the optional mock Agent:
HOST_ID=
AGENT_TOKEN=

# Persistent AES-256 key, 64 hex chars; never lose this or change it without re-encryption
MASTER_KEY=
