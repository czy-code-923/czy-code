    "/api/v1/subscriptions/{id}/qr": {
      "get": {
        "summary": "Private subscription or individual node PNG QR",
        "description": "Contains credentials. No-store; requires subscriptions:links. Preview never creates devices or consumes slots. Strict unbound HWID subscriptions require real client registration before exporting content or node URIs.",
        "x-required-scopes": [
          "subscriptions:links"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "client",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Client ID from GET /client-catalog; auto detects the requesting app. Explicit choice overrides User-Agent."
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "enum": [
                "subscription",
                "node"
              ]
            }
          },
          {
            "name": "node_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ID from /nodes when kind=node"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Missing permission"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "409": {
            "description": "Version conflict or device identity required"
          },
          "422": {
            "description": "No compatible client output"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
